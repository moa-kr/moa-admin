{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moa-kr.github.io/moa-admin/config/site-config.schema.json",
  "title": "MOA site-config.json",
  "description": "포켓몬카드모아(moa-kr/pokemoa)와 회사복지모아(moa-kr/bokjinabi)가 함께 읽는 공통 사이트 설정 파일입니다. 모아 어드민이 이 형식으로 커밋합니다.",
  "type": "object",
  "required": ["schemaVersion", "site", "siteName", "copy", "banner", "popup", "navigation"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1, "description": "형식 버전. 바뀌면 사이트가 호환 여부를 판단합니다." },
    "site": { "type": "string", "enum": ["pokemoa", "bokjimoa"], "description": "설정을 소유한 사이트 ID." },
    "siteName": { "type": "string", "maxLength": 40, "description": "사이트 표시 이름(보통 copy.siteTitle 과 같음)." },
    "theme": {
      "type": "object",
      "properties": {
        "accent": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
        "accentSoft": { "type": "string" },
        "mode": { "type": "string", "enum": ["light", "dark"] }
      },
      "additionalProperties": true
    },
    "copy": {
      "type": "object",
      "description": "화면 문구. 빈 문자열이면 사이트 기본 문구를 그대로 씁니다.",
      "required": ["siteTitle", "subtitle", "heroTitle", "heroDescription", "footerText"],
      "properties": {
        "siteTitle": { "type": "string", "maxLength": 30 },
        "subtitle": { "type": "string", "maxLength": 60 },
        "heroTitle": { "type": "string", "maxLength": 80 },
        "heroDescription": { "type": "string", "maxLength": 300 },
        "ctaLabel": { "type": "string", "maxLength": 24 },
        "footerText": { "type": "string", "maxLength": 200 }
      },
      "additionalProperties": true
    },
    "banner": {
      "type": "object",
      "description": "상단 공지 바. enabled=false 이면 사이트는 아무것도 그리지 않습니다.",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "text": { "type": "string", "maxLength": 120 },
        "linkUrl": { "type": "string", "maxLength": 500 },
        "linkLabel": { "type": "string", "maxLength": 20 },
        "style": { "type": "string", "enum": ["info", "warn", "urgent"] },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": true
    },
    "popup": {
      "type": "object",
      "description": "첫 방문 팝업. startDate/endDate(YYYY-MM-DD)가 비면 기간 제한 없음.",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "id": { "type": "string", "description": "팝업 식별자. 내용을 바꾸면 새 id 로 발급해 ‘다시 보지 않기’를 무효화합니다." },
        "title": { "type": "string", "maxLength": 60 },
        "body": { "type": "string", "maxLength": 600 },
        "buttonText": { "type": "string", "maxLength": 20 },
        "buttonUrl": { "type": "string", "maxLength": 500 },
        "startDate": { "type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$" },
        "endDate": { "type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$" },
        "dismissDays": { "type": "integer", "minimum": 0, "maximum": 90 },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": true
    },
    "navigation": {
      "type": "object",
      "description": "탭·섹션의 순서(order, 1부터)와 노출(visible). 사이트는 같은 탭(패널) 안에서 order 오름차순으로 그립니다.",
      "required": ["tabs", "sections"],
      "properties": {
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "visible", "order"],
            "properties": {
              "id": { "type": "string", "description": "사이트 코드가 쓰는 탭 식별자(예: map, home, schedule, guide, trends)." },
              "label": { "type": "string", "maxLength": 20 },
              "visible": { "type": "boolean" },
              "order": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": true
          }
        },
        "sections": {
          "type": "array",
          "description": "탭 안쪽 블록(섹션). tab 으로 어느 탭의 섹션인지 적고, order 는 그 탭 안에서 1부터 매깁니다.",
          "items": {
            "type": "object",
            "required": ["id", "label", "visible", "order"],
            "properties": {
              "id": { "type": "string", "description": "사이트 HTML 의 data-section 값(예: map-status, hero, pricing, issues, rates, cards, faq, pop)." },
              "label": { "type": "string", "maxLength": 60, "description": "섹션 제목([data-section-title]). 화면 제목을 copy 키로 그리는 섹션에서는 목록에 보일 이름으로만 쓰입니다." },
              "visible": { "type": "boolean" },
              "order": { "type": "integer", "minimum": 1, "description": "같은 탭 안에서의 순서." },
              "tab": { "type": "string", "description": "이 섹션이 들어 있는 탭 id(navigation.tabs 의 id). 어드민이 탭별로 묶어 보여 줍니다. 비면 사이트의 기본 탭을 씁니다." },
              "body": { "type": "string", "maxLength": 600, "description": "섹션 맨 아래에 덧붙는 본문 문단(<b>·<br> 등 일부 태그 허용). 비우면 그리지 않습니다." }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "cards": {
      "type": "array",
      "description": "현황 카드(제목·설명). visible=false 이면 숨깁니다.",
      "items": {
        "type": "object",
        "required": ["id", "title", "visible", "order"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "maxLength": 30 },
          "description": { "type": "string", "maxLength": 80 },
          "visible": { "type": "boolean" },
          "order": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" },
        "note": { "type": "string", "maxLength": 300 }
      },
      "additionalProperties": true
    }
  }
}
